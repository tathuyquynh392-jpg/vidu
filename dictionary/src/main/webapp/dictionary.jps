
<%@page import="java.util.HashMap"%>
<%@page import="java.util.Map"%>
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kết quả tra cứu</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .container {
            background: white;
            width: 400px;
            max-width: calc(100% - 60px);
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px #cbd5e1;
            text-align: center;
        }

        h1 {
            color: #1b2a7a;
            font-size: 24px;
        }

        .success {
            background: #dcfce7;
            color: #166534;
            padding: 15px;
            border-radius: 8px;
        }

        .error {
            background: #fee2e2;
            color: #991b1b;
            padding: 15px;
            border-radius: 8px;
        }

        .back-btn {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 20px;
            background: #1b2a7a;
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }

        .back-btn:hover {
            background: #121c54;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Kết quả tra cứu</h1>

        <%
            request.setCharacterEncoding("UTF-8");

            String searchWord = request.getParameter("search");
            Map<String, String> dictionary = new HashMap<>();

            dictionary.put("hello", "Xin chào");
            dictionary.put("how", "Thế nào");
            dictionary.put("book", "Quyển sách");
            dictionary.put("computer", "Máy tính");
            dictionary.put("student", "Sinh viên");
            dictionary.put("school", "Trường học");
            dictionary.put("apple", "Quả táo");

            String result = null;

            if (searchWord != null && !searchWord.trim().isEmpty()) {
                result = dictionary.get(searchWord.trim().toLowerCase());
            }
        %>

        <% if (result != null) { %>
            <p>Từ tiếng Anh: <strong><%= searchWord %></strong></p>
            <div class="success">
                <h2><%= result %></h2>
            </div>
        <% } else { %>
            <div class="error">
                <h3>Không tìm thấy từ!</h3>
                <p>Vui lòng kiểm tra lại từ khóa.</p>
            </div>
        <% } %>

        <a href="index.jsp" class="back-btn">Quay lại</a>
    </div>
</body>
</html>
